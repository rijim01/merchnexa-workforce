# MerchNexa WorkHub Environment Configuration

# Server Port & Admin Identity
PORT=5000
ADMIN_EMAIL=your-admin-email@gmail.com

# Google Sheets API & Google Drive API (Service Account)
GOOGLE_CLIENT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Firebase Admin SDK (Backend)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Frontend Vite Configuration & Firebase Web Client SDK
VITE_API_BASE_URL=http://localhost:5000/api
VITE_ADMIN_EMAIL=your-admin-email@gmail.com
VITE_GOOGLE_CLIENT_ID=your_oauth2_client_id.apps.googleusercontent.com
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:...:web:...
VITE_FIREBASE_MEASUREMENT_ID=G-...
